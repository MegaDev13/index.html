<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <queries>
        <intent><action android:name="android.service.wallpaper.WallpaperService"/></intent>
        <package android:name="com.openai.chatgpt"/>
        <package android:name="com.termux"/>
        <intent><action android:name="android.speech.RecognitionService"/></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <intent><action android:name="org.adw.launcher.THEMES"/></intent>
    </queries>
    <application android:allowBackup="false" android:label="NEON OS" android:icon="@drawable/ic_neon" android:theme="@style/NeonTheme" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:resizeableActivity="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <activity android:name=".LockStudioActivity" android:exported="false"/>
        <activity android:name=".HudSettingsActivity" android:exported="false"/>
        <activity android:name=".IconStudioActivity" android:exported="false"/>
        <activity android:name=".WallpaperActivity" android:exported="false"/>
        <activity android:name=".ReleaseActivity" android:exported="false"/>
        <service android:name=".NeonLiveWallpaper" android:label="NEON Circuit Live"
            android:exported="true" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService"/></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/neon_wallpaper"/>
        </service>
        <service android:name=".NeonKeyboard" android:label="Teclado NEON"
            android:exported="true" android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/neon_keyboard"/>
        </service>
        <activity android:name=".KeyboardConfigActivity" android:exported="true"/>
        <activity android:name=".KeyboardTranslateActivity" android:exported="false" android:windowSoftInputMode="stateHidden|adjustResize"/>
        <provider android:name=".KeyboardGifProvider" android:authorities="${applicationId}.keyboard-gif"
            android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".BridgeActivity" android:exported="false"/>
        <activity android:name=".TerminalActivity" android:exported="false" android:windowSoftInputMode="stateHidden|adjustResize"/>
        <activity android:name=".AtlasActivity" android:exported="false" android:windowSoftInputMode="stateHidden|adjustResize"/>
        <activity android:name=".AtlasEntryActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.ASSIST"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <receiver android:name=".AtlasWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/atlas_widget"/>
        </receiver>
        <activity android:name=".PinActivity" android:exported="true" android:theme="@style/NeonTheme">
            <intent-filter><action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <receiver android:name=".NeonWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/neon_widget"/>
        </receiver>
        <receiver android:name=".TerminalWidget" android:label="NEON Terminal" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/terminal_widget"/>
        </receiver>
    </application>
</manifest>
