<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/atlas_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg_corporate">
<ImageView android:id="@+id/atlas_widget_orb" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Núcleo ATLAS"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
<TextView android:id="@+id/atlas_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ATLAS" android:textColor="#E1B76B" android:textSize="18sp" android:fontFamily="sans-serif-condensed"/>
<TextView android:id="@+id/atlas_widget_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHATGPT / TOCAR PARA ABRIR" android:textColor="#85909B" android:textSize="9sp" android:fontFamily="monospace"/>
</LinearLayout>
<TextView android:id="@+id/atlas_widget_panel" android:layout_width="60dp" android:layout_height="48dp" android:gravity="center" android:text="PAINEL" android:textColor="#E1B76B" android:textSize="10sp" android:fontFamily="monospace"/>
</LinearLayout>