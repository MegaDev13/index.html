# Server-side secrets only. Never put this in Android resources or commit a real .env.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set conservative ceilings using the selected model's verified current prices.
INPUT_PRICE_CEILING_PER_MILLION=
OUTPUT_PRICE_CEILING_PER_MILLION=
ATLAS_DB=/data/atlas.sqlite3
ATLAS_BIND=127.0.0.1
# Used only for --add-user, then remove from the environment.
ATLAS_NEW_PASSWORD=
